NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postai:postai@127.0.0.1:5432/postai
CORS_ORIGIN=http://127.0.0.1:5173
JWT_SECRET=change-me-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=postai-api
JWT_AUDIENCE=postai-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_MAX_ATTEMPTS_PER_EMAIL=5
AUTH_LOGIN_MAX_ATTEMPTS_PER_IP=30
AUTH_REFRESH_MAX_ATTEMPTS_PER_IP=60
